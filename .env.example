# Modèle de configuration. Copier en .env (jamais versionné) puis adapter.
APP_NAME=PDIF
ENVIRONMENT=developpement
# Développement : SQLite (fichier local). Production BRH : postgresql+psycopg://utilisateur:motdepasse@hote:5432/pdif
DATABASE_URL=sqlite:///./pdif.db
FRONTEND_ORIGIN=http://localhost:5173

# Clé secrète des jetons de connexion (au moins 32 caractères). À générer, jamais à partager :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer-par-une-cle-generee-de-plus-de-32-caracteres
DUREE_SESSION_MINUTES=480

# Pays suivis
PAYS_PRINCIPAL=HTI
PAYS_COMPARAISON=DOM,JAM,NIC,BRA,FRA,CAN

# Réseau
HTTP_TIMEOUT_SECONDES=25
HTTP_ESSAIS=5
HTTP_ATTENTE_SECONDES=2

# Mises à jour automatiques (true pour les activer)
PLANIFICATION_ACTIVE=false

# Dépôt par les directions : à laisser à false tant que la plateforme n'est pas hébergée à la BRH
DEPOTS_DIRECTIONS_OUVERTS=false
